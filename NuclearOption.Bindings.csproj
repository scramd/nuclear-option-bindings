<Project Sdk="Microsoft.NET.Sdk">
  <!-- Packs src/NuclearBindings as a source-only package: consumers compile the files into their own mod. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoWarn>$(NoWarn);NU5128</NoWarn>

    <PackageId>NuclearOption.Bindings</PackageId>
    <Version>0.1.0</Version>
    <Authors>scramd</Authors>
    <Description>Unofficial key and button bindings for Nuclear Option BepInEx 5 mods. Players bind keys, key combinations, mouse buttons, gamepad controls and HOTAS buttons, hats and axes in ConfigurationManager (F1) by pressing the control. Keys are read through Unity input, controllers through the game's Rewired. Source-only: the code compiles into your mod, so there is no extra DLL or plugin dependency.</Description>
    <PackageTags>nuclear-option;bepinex;rewired;keybinds;input;hotas;gamepad;configurationmanager</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/scramd/nuclear-option-bindings</PackageProjectUrl>
    <RepositoryUrl>https://github.com/scramd/nuclear-option-bindings.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>https://github.com/scramd/nuclear-option-bindings/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="src/NuclearBindings/*.cs" Pack="true" PackagePath="contentFiles/cs/any/NuclearBindings/" BuildAction="Compile" />
    <None Include="README.md;LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
